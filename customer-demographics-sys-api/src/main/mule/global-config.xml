<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway" xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- Configuration Properties -->
    <configuration-properties doc:name="Configuration properties" file="config/config-dev.yaml" />

    <!-- HTTP Listener Config -->
    <http:listener-config name="customer-demographics-httpListenerConfig">
        <http:listener-connection host="${http.host}" port="${http.port}" />
    </http:listener-config>

    <!-- APIkit Config -->
    <apikit:config name="customer-demographics-apiConfig"
                   api="api/customer-demographics-sys-api.raml"
                   outboundHeadersMapName="outboundHeaders"
                   httpStatusVarName="httpStatus" />

    <!-- API Autodiscovery -->
    <api-gateway:autodiscovery apiId="${api.id}"
                               ignoreBasePath="true"
                               doc:name="API Autodiscovery"
                               flowRef="customer-demographics-sys-api-main" />

    <!-- Global Error Handler -->
    <db:config name="Database_Config" doc:name="Database Config" doc:id="9714403c-413a-4ca0-9eeb-16eec5b1dc21" >
		<db:my-sql-connection host="${db.host}" port="${db.port}" user="${db.user}" password="${db.password}" database="${db.database}" />
	</db:config>
	<error-handler name="global-error-handler">
        <on-error-propagate type="APIKIT:BAD_REQUEST" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="400" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Bad Request",&#10;                message: error.description default "Invalid request payload or query parameters",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:NOT_FOUND" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="404" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Not Found",&#10;                message: "Resource not found",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="405" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Method Not Allowed",&#10;                message: "HTTP method is not allowed on this endpoint",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:NOT_ACCEPTABLE" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="406" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Not Acceptable",&#10;                message: "Not acceptable response media type",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="415" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Unsupported Media Type",&#10;                message: "Unsupported payload media type",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>

        <on-error-propagate type="ANY" enableNotifications="true" logException="true">
            <set-variable variableName="httpStatus" value="500" />
            <set-payload value='#[output application/json --- {&#10;                timestamp: now(),&#10;                status: vars.httpStatus,&#10;                error: "Internal Server Error",&#10;                message: error.description default "An unexpected error occurred",&#10;                correlationId: correlationId&#10;            }]' />
        </on-error-propagate>
    </error-handler>

</mule>
