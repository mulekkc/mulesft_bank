#%RAML 1.0 DataType
type: object
properties:
  customerId?:
    type: string
    example: "CUST-1001"
  firstName:
    type: string
    required: true
    example: "John"
  lastName:
    type: string
    required: true
    example: "Doe"
  email:
    type: string
    required: true
    pattern: ^.+@.+\..+$
    example: "john.doe@example.com"
  phone:
    type: string
    required: true
    example: "+1-555-234-5678"
  dateOfBirth:
    type: date-only
    required: true
    example: "1988-06-15"
  address:
    type: object
    required: true
    properties:
      street: string
      city: string
      state: string
      postalCode: string
      country: string
  status?:
    type: string
    enum: [ACTIVE, INACTIVE, SUSPENDED]
    default: "ACTIVE"
  createdAt?:
    type: datetime
  updatedAt?:
    type: datetime
